# anchor-bankrun 0.5.0 declares a peer of @coral-xyz/anchor ^0.30, but the program is pinned to
# Anchor 0.31.1 by the Pyth receiver SDK (code.md §3.2) and the two work together fine — bankrun
# only needs Anchor's coder. Without this, a plain `npm install` fails on the peer conflict.
legacy-peer-deps=true
