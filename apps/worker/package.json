    "@pythnetwork/pyth-solana-receiver": "^0.16.0",
    "@solana/spl-token": "0.4.14",
    "@solana/web3.js": "^1.98.0",
    "@stock-arena/idl": "*",
    "@stock-arena/integrations": "*",
    "@stock-arena/shared": "*",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  }
}
