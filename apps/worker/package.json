{
  "name": "@stock-arena/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --target=node20 --format=cjs --outfile=dist/worker.cjs --external:@prisma/client --sourcemap",
    "start": "node dist/worker.cjs",
    "dev": "npm run build && npm start"
