# Copy to .env and fill in. Never commit .env, keypair JSON, API keys or database URLs.
# Server secrets must never appear under NEXT_PUBLIC_*.

NEXT_PUBLIC_SOLANA_CLUSTER=devnet
NEXT_PUBLIC_SOLANA_RPC_URL=
NEXT_PUBLIC_PROGRAM_ID=8xYafVKnRmi99cRPQV2TLRHRH2MsfjZtJH4DMy8anHiC

SOLANA_RPC_URL=
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/stock_arena
INTERNAL_WORKER_SECRET=
# Dedicated, minimally funded devnet orchestrator. Never a wallet holding real value.
ORCHESTRATOR_KEYPAIR_JSON=
ADMIN_WALLET=

PRESTOCKS_API_URL=https://prestocks.com/api/prestocks

# Which PreStocks tokens get an Arena. Nothing is hard-coded to a single token: each Arena is its
# own on-chain account keyed by its mint, carrying its own Pyth feed. Adding a token is a devnet
# test mint plus one create_arena call, not a code change.
ARENAS_CONFIG_PATH=config/arenas.json

# Read-only, for displaying a player's real mainnet PreStocks balances. Never used to move value
# and never a source of any price the program trusts.
SOLANA_MAINNET_RPC_URL=

QUOTE_ASSET_DEVNET_MINT=

PYTH_HERMES_URL=https://pyth.dourolabs.app/hermes
PYTH_API_KEY=
PYTH_BENCHMARK_SYMBOL=Equity.US.TSLA/USD
# 32-byte Core feed ID only (0x + 64 hex). A Terminal/Lazer ID such as 1435 (TSLA) is NOT a Core
# ID and must never go here.
PYTH_BENCHMARK_FEED_ID=
PYTH_BENCHMARK_EXPONENT=-5

CLAWPUMP_BASE_URL=https://clawpump.tech/api/v1
CLAWPUMP_API_KEY=
CLAWPUMP_PAID_MODEL=

# Worker loop interval. The tick is cheap (one getProgramAccounts) and every action it takes is
# behind an idempotency lease, so a short interval costs little and keeps round windows tight.
WORKER_TICK_INTERVAL_MS=5000

# Courtesy staleness bound for the UI only. The authoritative check is inside activate_match and
# uses the Arena and ProtocolConfig values, whichever is stricter. code.md 5.2.
BENCHMARK_MAX_AGE_SECONDS=60
