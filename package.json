{
  "name": "stock-arena",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --build --force && tsc -p tests/tsconfig.json && npm run typecheck --workspace @stock-arena/web",
    "test": "vitest run packages apps",
    "build": "tsc --build && npm run build --workspace @stock-arena/worker && npm run build --workspace @stock-arena/web",
    "test:program": "vitest run tests",
    "wsl:deps": "npm install --no-save --force @esbuild/linux-x64@0.21.5 @rollup/rollup-linux-x64-gnu@4.63.4 solana-bankrun-linux-x64-gnu@0.4.0",
    "sync:idl": "bash scripts/sync-idl.sh",
    "dev:web": "node --env-file=.env node_modules/next/dist/bin/next dev apps/web",
    "dev:worker": "npm run build --workspace @stock-arena/worker && node --env-file=.env apps/worker/dist/worker.cjs",
    "setup:devnet": "esbuild scripts/setup-devnet.ts --bundle --platform=node --format=cjs --log-level=warning --outfile=target/setup-devnet.cjs && node target/setup-devnet.cjs",
    "test:integration:clawpump": "esbuild scripts/gate-clawpump.ts --bundle --platform=node --format=cjs --external:@prisma/client --log-level=warning --outfile=target/gate-clawpump.cjs && node --env-file=.env target/gate-clawpump.cjs"
  },
  "devDependencies": {
    "@coral-xyz/anchor": "0.31.1",
    "@solana/spl-token": "0.4.14",
    "@types/node": "^22.10.2",
    "anchor-bankrun": "^0.5.0",
    "jito-ts": "file:vendor/jito-ts-stub",
    "prettier": "^3.4.2",
    "prisma": "^6.16.2",
    "solana-bankrun": "^0.4.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@prisma/client": "^6.16.2"
  }
}
